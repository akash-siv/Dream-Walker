# ── Kafka Broker ───────────────────────────────────────────────────────────
# For local Docker dev: localhost:9092
# For Confluent Cloud:  pkc-<id>.<region>.confluent.cloud:9092
# For Azure Event Hubs: <namespace>.servicebus.windows.net:9093
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Confluent Cloud / SASL auth — leave blank for local plaintext broker
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Topics ─────────────────────────────────────────────────────────────────
KAFKA_TOPIC_RAW=dreamwalker.sensor.raw          # bronze source
KAFKA_TOPIC_FEATURES=dreamwalker.sensor.features # silver source

# Partitions = max concurrent users you expect at once
KAFKA_NUM_PARTITIONS=4
KAFKA_REPLICATION_FACTOR=1   # set to 3 on a multi-broker cloud cluster

# Consumer group used by the Spark Structured Streaming job
KAFKA_GROUP_ID=dreamwalker.spark.consumer

# ── Device / Serial ────────────────────────────────────────────────────────
# COM port of the ESP32 receiver connected to this PC
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200

# ── Signal Parameters ──────────────────────────────────────────────────────
SAMPLE_RATE_HZ=250
WINDOW_SIZE_SECONDS=4
# Derived: WINDOW_SIZE_SAMPLES = SAMPLE_RATE_HZ * WINDOW_SIZE_SECONDS = 1000

# Sliding window overlap in seconds (0 = tumbling / non-overlapping)
WINDOW_OVERLAP_SECONDS=0

# Axes collected per leg: accel_x, accel_y, accel_z, gyro_x, gyro_y, gyro_z
NUM_AXES_PER_LEG=6

# ── Session / Labeling ─────────────────────────────────────────────────────
# Set before each recording session. Attached to every Kafka message.
# Values: idle | walking | running | jogging | stairs_up | stairs_down
SESSION_LABEL=idle
SESSION_ID=session_001   # increment per session for traceability

# ── Delta Lake Paths (Databricks DBFS or Unity Catalog volume) ─────────────
DELTA_BRONZE_PATH=/mnt/dreamwalker/bronze
DELTA_SILVER_PATH=/mnt/dreamwalker/silver
DELTA_CHECKPOINT_BRONZE=/mnt/dreamwalker/checkpoints/bronze
DELTA_CHECKPOINT_SILVER=/mnt/dreamwalker/checkpoints/silver

# ── Databricks ─────────────────────────────────────────────────────────────
# Used by the Edge Impulse upload script, not by the Spark jobs themselves.
# In Databricks notebooks, use dbutils.secrets instead of reading this file.
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=

# ── Edge Impulse ───────────────────────────────────────────────────────────
EDGE_IMPULSE_API_KEY=
EDGE_IMPULSE_PROJECT_ID=
